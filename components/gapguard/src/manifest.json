{
  "manifest_version": 3,
  "name": "GapGuard — Personal Ad Blocker",
  "short_name": "GapGuard",
  "version": "0.1.2",
  "description": "Personal ad and tracker filtering with deduplicated lists and optional recovery tools.",
  "minimum_chrome_version": "121",
  "permissions": ["storage", "unlimitedStorage", "tabs", "activeTab", "scripting", "webRequest", "webNavigation", "cookies", "declarativeNetRequest", "declarativeNetRequestFeedback"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "GapGuard", "default_popup": "popup.html", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content-script.js"], "all_frames": true, "match_about_blank": true, "run_at": "document_start" },
    { "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["youtube-recovery.js"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [{ "resources": ["web-accessible-resources/redirects/*"], "matches": ["http://*/*", "https://*/*"] }]
}
